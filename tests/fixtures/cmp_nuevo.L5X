            </RLLContent>
          </Routine>
          <Routine Name="Estacion1" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text><![CDATA[XIC(A) OTE(B);]]></Text></Rung>
              <Rung Number="1" Type="N"><Text><![CDATA[XIC(Nuevo_Permiso)OTE(Z);]]></Text></Rung>
              <Rung Number="2" Type="N"><Comment><![CDATA[Arranque de motor]]></Comment><Text><![CDATA[XIC(C)XIO(D)OTE(E);]]></Text></Rung>
              <Rung Number="3" Type="N"><Text><![CDATA[XIC(F)TON(T1,?,?);]]></Text></Rung>
              <Rung Number="4" Type="N"><Text><![CDATA[XIC(T1.DN)XIC(Permiso)OTE(G);]]></Text></Rung>
              <Rung Number="5" Type="N"><Text><![CDATA[[XIC(J) ,XIC(K) ]OTE(L);]]></Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Calculos" Type="ST">
            <STContent>
              <Line Number="0"><![CDATA[Total :=  A + B;]]></Line>
              <Line Number="1"><![CDATA[IF Total > 150 THEN]]></Line>
              <Line Number="2"><![CDATA[    Alarma := 1;]]></Line>
              <Line Number="3"><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
          <Routine Name="Mezcla" Type="FBD">
            <FBDContent SheetOrientation="Landscape" SheetSize="Letter - 8.5 x 11 in">
              <Sheet Number="1">
                <IRef ID="0" X="100" Y="100" Operand="Flujo_A" HideDesc="false"/>
                <IRef ID="1" X="100" Y="160" Operand="Flujo_B" HideDesc="false"/>
                <Block ID="2" Type="ADD" X="240" Y="120" Operand="ADD_01" VisiblePins="SourceA SourceB Dest" HideDesc="false"/>
                <ORef ID="3" X="400" Y="120" Operand="Flujo_Mezcla" HideDesc="false"/>
                <Wire FromID="0" ToID="2" ToParam="SourceA"/>
                <Wire FromID="1" ToID="2" ToParam="SourceB"/>
                <Wire FromID="2" FromParam="Dest" ToID="3"/>
              </Sheet>
            </FBDContent>
          </Routine>
          <Routine Name="Secuencia" Type="SFC">
            <SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step_" TransitionName="Tran_" ActionName="Action_" StopName="Stop_">
              <Step ID="0" X="100" Y="100" Operand="Step_000" HideDesc="false" DescX="120" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true"/>
              <Transition ID="1" X="100" Y="180" Operand="Tran_000" HideDesc="false" DescX="120" DescY="160" DescWidth="0">
                <Condition><STContent><Line Number="0"><![CDATA[Arranque]]></Line></STContent></Condition>
              </Transition>
              <DirectedLink FromID="0" ToID="1" Show="true"/>
            </SFCContent>
          </Routine>
          <Routine Name="Rutina_Nueva" Type="ST">
            <STContent>
              <Line Number="0"><![CDATA[Contador_Lotes := Contador_Lotes + 1;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
